}
.tl-card h3 { margin-bottom: 6px; }
.tl-card p { color: var(--text-2); font-size: 14.5px; }
.tl-item.upcoming .tl-card { opacity: .7; }
.tl-item.upcoming .tl-card .yr { color: var(--text-3); background: rgba(255,255,255,.04); border-color: var(--line); }

