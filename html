   ========================================= */
.timeline {
  position: relative;
  max-width: 820px;
  margin: 0 auto;
  padding: 20px 0;
}
.timeline::before {
  content: "";
  position: absolute;
  left: 28px; top: 0; bottom: 0;
  width: 2px;
  background: linear-gradient(180deg, transparent, var(--blue) 10%, var(--purple) 50%, var(--cyan) 90%, transparent);
  opacity: .35;
}
.tl-item {
  position: relative;
  padding-left: 70px;
  margin-bottom: 28px;
}
.tl-item:last-child { margin-bottom: 0; }
.tl-dot {
  position: absolute;
  left: 18px; top: 18px;
  width: 22px; height: 22px;
  border-radius: 50%;
  background: var(--bg-0);
  border: 2px solid var(--blue);
  display: grid; place-items: center;
}
.tl-dot::after {
  content: "";
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--grad-primary);
}
.tl-item.upcoming .tl-dot { border-color: var(--text-3); }
.tl-item.upcoming .tl-dot::after { background: transparent; border: 1px dashed var(--text-3); }
.tl-card {
  background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.01));
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 22px 24px;
  transition: transform .3s var(--ease), border-color .25s;
}
.tl-card:hover { transform: translateX(4px); border-color: var(--line-2); }
.tl-card .yr {
