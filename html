<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content="Paulo Marques — Aspiring Front-End Developer. Portfolio, projects, skills and learning journey." />
<title>Paulo Marques — Aspiring Front-End Developer</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

<style>
/* =========================================
   DESIGN TOKENS
   ========================================= */
:root {
  --bg-0: #020617;
  --bg-1: #0b1224;
  --bg-2: #0f172a;
  --bg-3: #111827;
  --bg-4: #1e293b;

  --blue: #3b82f6;
  --blue-2: #60a5fa;
  --cyan: #06b6d4;
  --purple: #a855f7;
  --pink: #ec4899;

  --text: #e6edf7;
  --text-2: #a3b1c6;
  --text-3: #6b7a93;
  --line: rgba(255, 255, 255, 0.08);
  --line-2: rgba(255, 255, 255, 0.14);

  --grad-primary: linear-gradient(135deg, #3b82f6 0%, #a855f7 100%);
  --grad-accent:  linear-gradient(135deg, #06b6d4 0%, #3b82f6 50%, #a855f7 100%);
  --grad-soft:    linear-gradient(135deg, rgba(59,130,246,0.15) 0%, rgba(168,85,247,0.15) 100%);

  --radius-sm: 10px;
  --radius:    16px;
  --radius-lg: 24px;

  --shadow-1: 0 6px 24px rgba(0,0,0,.35);
  --shadow-2: 0 20px 60px rgba(0,0,0,.45);
  --shadow-glow: 0 0 60px rgba(99,102,241,.25);

  --ease: cubic-bezier(.22,.61,.36,1);
}

/* =========================================
   RESET / BASE
   ========================================= */
* { box-sizing: border-box; margin: 0; padding: 0; }
*::selection { background: rgba(168,85,247,.35); color: #fff; }

html { scroll-behavior: smooth; }

body {
  background: var(--bg-0);
  color: var(--text);
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 16px;
  line-height: 1.6;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

a { color: inherit; text-decoration: none; }
button { font: inherit; cursor: pointer; border: none; background: none; color: inherit; }
img { max-width: 100%; display: block; }

.container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
}

/* =========================================
   BACKGROUND BLOBS (animated)
   ========================================= */
.bg-canvas {
  position: fixed;
  inset: 0;
  z-index: -1;
  overflow: hidden;
  pointer-events: none;
}
.bg-canvas .blob {
  position: absolute;
  width: 540px; height: 540px;
  border-radius: 50%;
  filter: blur(110px);
  opacity: .55;
  animation: float 22s ease-in-out infinite;
}
.bg-canvas .blob.b1 { background: #3b82f6; top: -120px; left: -120px; }
.bg-canvas .blob.b2 { background: #a855f7; bottom: -160px; right: -120px; animation-delay: -6s; }
.bg-canvas .blob.b3 { background: #06b6d4; top: 40%; left: 50%; transform: translate(-50%, -50%); opacity: .25; animation-delay: -12s; }

@keyframes float {
  0%, 100% { transform: translate(0,0) scale(1); }
  33%      { transform: translate(60px,-40px) scale(1.08); }
  66%      { transform: translate(-40px,60px) scale(.95); }
}

/* Subtle grid */
.bg-canvas .grid-overlay {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
  background-size: 60px 60px;
  mask-image: radial-gradient(ellipse at center, #000 30%, transparent 80%);
  -webkit-mask-image: radial-gradient(ellipse at center, #000 30%, transparent 80%);
}

/* =========================================
   NAV
   ========================================= */
.nav {
  position: fixed;
  top: 16px; left: 50%;
  transform: translateX(-50%);
  z-index: 100;
  width: calc(100% - 32px);
  max-width: 1100px;
  background: rgba(15, 23, 42, 0.55);
  backdrop-filter: blur(18px) saturate(160%);
  -webkit-backdrop-filter: blur(18px) saturate(160%);
  border: 1px solid var(--line);
  border-radius: 100px;
  padding: 10px 14px 10px 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: var(--shadow-1);
  transition: top .3s var(--ease);
}
.nav.scrolled { top: 12px; }
.nav-logo {
  font-family: 'Space Grotesk', sans-serif;
  font-weight: 700;
  font-size: 18px;
  letter-spacing: -.01em;
  display: flex;
  align-items: center;
  gap: 10px;
}
.nav-logo .dot {
  width: 10px; height: 10px;
  border-radius: 50%;
  background: var(--grad-primary);
  box-shadow: 0 0 12px rgba(168,85,247,.7);
  animation: pulse 2s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50%      { transform: scale(1.25); opacity: .85; }
}
.nav-links {
  display: flex;
  gap: 4px;
  align-items: center;
}
.nav-links a {
  padding: 8px 14px;
  font-size: 14px;
  color: var(--text-2);
  border-radius: 100px;
  transition: color .2s, background .2s;
}
.nav-links a:hover { color: #fff; background: rgba(255,255,255,.05); }
.nav-cta {
  padding: 9px 18px;
  font-size: 14px;
  font-weight: 600;
  background: #fff;
  color: #020617;
  border-radius: 100px;
  transition: transform .2s var(--ease);
}
.nav-cta:hover { transform: translateY(-1px); }
.nav-toggle {
  display: none;
  width: 38px; height: 38px;
  border-radius: 100px;
  background: rgba(255,255,255,.05);
  align-items: center; justify-content: center;
}

/* =========================================
   TYPOGRAPHY HELPERS
   ========================================= */
.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  background: var(--grad-soft);
  border: 1px solid var(--line-2);
  border-radius: 100px;
  font-size: 12px;
  font-weight: 500;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--text-2);
  backdrop-filter: blur(8px);
}
.eyebrow .pulse-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: #34d399;
  box-shadow: 0 0 10px #34d399;
  animation: pulse 2s ease-in-out infinite;
}

h1, h2, h3, h4 {
  font-family: 'Space Grotesk', sans-serif;
  letter-spacing: -.02em;
  line-height: 1.1;
}
h1 { font-size: clamp(40px, 7vw, 84px); font-weight: 700; }
h2 { font-size: clamp(30px, 4.5vw, 52px); font-weight: 700; }
h3 { font-size: clamp(20px, 2vw, 26px); font-weight: 600; }

.gradient-text {
  background: var(--grad-primary);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.accent-text {
  background: var(--grad-accent);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* =========================================
   BUTTONS
   ========================================= */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 14px 24px;
  border-radius: 100px;
  font-size: 15px;
  font-weight: 600;
  transition: transform .25s var(--ease), box-shadow .25s var(--ease), background .25s var(--ease);
  white-space: nowrap;
}
.btn svg { width: 18px; height: 18px; }
.btn-primary {
  background: #fff;
  color: #020617;
  box-shadow: 0 10px 30px rgba(255,255,255,.15), 0 0 0 1px rgba(255,255,255,.1);
}
.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 14px 40px rgba(255,255,255,.22), 0 0 0 1px rgba(255,255,255,.15);
}
.btn-ghost {
  background: rgba(255,255,255,.06);
  border: 1px solid var(--line-2);
  color: var(--text);
  backdrop-filter: blur(10px);
}
.btn-ghost:hover {
  background: rgba(255,255,255,.1);
  border-color: rgba(255,255,255,.25);
  transform: translateY(-2px);
}
.btn-gradient {
  background: var(--grad-primary);
  color: #fff;
  box-shadow: 0 10px 30px rgba(99,102,241,.35);
}
.btn-gradient:hover {
  transform: translateY(-2px);
  box-shadow: 0 14px 40px rgba(99,102,241,.5);
}

/* =========================================
   SECTIONS — shared
   ========================================= */
section { padding: 120px 0; position: relative; }
.section-head {
  max-width: 720px;
  margin: 0 auto 64px;
  text-align: center;
}
.section-head .eyebrow { margin-bottom: 18px; }
.section-head p {
  margin-top: 18px;
  color: var(--text-2);
  font-size: 17px;
}

/* =========================================
   HERO
   ========================================= */
.hero {
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding: 160px 0 100px;
  position: relative;
}
.hero-grid {
  display: grid;
  grid-template-columns: 1.1fr .9fr;
  gap: 60px;
  align-items: center;
}
.hero-greeting {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 15px;
  color: var(--text-2);
  letter-spacing: .04em;
  margin-bottom: 14px;
}
.hero-greeting .wave { display: inline-block; animation: wave 2.5s ease-in-out infinite; transform-origin: 70% 70%; }
@keyframes wave { 0%,100%{transform:rotate(0)} 10%,30%{transform:rotate(14deg)} 20%{transform:rotate(-8deg)} 40%{transform:rotate(0)} }
.hero-name { margin-bottom: 18px; }
.hero h1 .typed { color: var(--text); }
.hero h1 .typed::after { content: "|"; color: var(--purple); animation: blink 1s step-end infinite; margin-left: 4px; }
@keyframes blink { 50% { opacity: 0; } }
.hero-sub {
  margin-top: 20px;
  font-size: 19px;
  color: var(--text-2);
  max-width: 540px;
}
.hero-sub strong { color: var(--text); font-weight: 600; }
.hero-ctas { margin-top: 36px; display: flex; gap: 14px; flex-wrap: wrap; }
.hero-meta {
  display: flex;
  gap: 28px;
  margin-top: 48px;
  flex-wrap: wrap;
}
.hero-meta .meta-item {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 14px;
  color: var(--text-2);
}
.hero-meta .meta-item .icon {
  width: 36px; height: 36px;
  border-radius: 10px;
  background: var(--grad-soft);
  border: 1px solid var(--line-2);
  display: grid; place-items: center;
  color: var(--blue-2);
}
.hero-meta .meta-item strong { color: var(--text); font-weight: 600; }

/* Hero 3D visual */
.hero-visual {
  position: relative;
  aspect-ratio: 1 / 1;
  max-width: 500px;
  margin-left: auto;
}
.hero-visual .core {
  position: absolute;
  inset: 14%;
  border-radius: 50%;
  background: var(--grad-primary);
  filter: blur(50px);
  opacity: .55;
  animation: float 8s ease-in-out infinite;
}
.hero-visual .ring {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  border: 1px solid var(--line-2);
  animation: spin 30s linear infinite;
}
.hero-visual .ring.r2 { inset: 12%; animation-duration: 50s; animation-direction: reverse; border-color: rgba(168,85,247,.25); }
.hero-visual .ring.r3 { inset: 24%; animation-duration: 22s; border-color: rgba(6,182,212,.3); }
@keyframes spin { to { transform: rotate(360deg); } }
.hero-visual .orbit-dot {
  position: absolute;
  top: 50%; left: -6px;
  width: 14px; height: 14px;
  border-radius: 50%;
  background: var(--cyan);
  box-shadow: 0 0 16px var(--cyan);
  transform: translateY(-50%);
}
.hero-visual .glass-card {
  position: absolute;
  background: rgba(15,23,42,0.55);
  border: 1px solid var(--line-2);
  backdrop-filter: blur(18px);
  border-radius: var(--radius);
  padding: 14px 18px;
  box-shadow: var(--shadow-1);
  display: flex; align-items: center; gap: 12px;
  font-size: 13px;
  color: var(--text-2);
  animation: float 6s ease-in-out infinite;
}
.hero-visual .glass-card.c1 { top: 8%;  left: -2%; animation-delay: 0s; }
.hero-visual .glass-card.c2 { bottom: 14%; right: -4%; animation-delay: -2s; }
.hero-visual .glass-card.c3 { top: 52%; left: 60%; animation-delay: -4s; }
.hero-visual .glass-card .ic {
  width: 32px; height: 32px;
  border-radius: 8px;
  background: var(--grad-soft);
  display: grid; place-items: center;
  color: var(--blue-2);
}
.hero-visual .glass-card strong { color: var(--text); display: block; font-size: 14px; }
.hero-visual .glass-card span { font-size: 12px; }
.hero-visual .mono-snippet {
  position: absolute;
  bottom: -2%; left: 0;
  background: rgba(2,6,23,.7);
  border: 1px solid var(--line-2);
  border-radius: var(--radius);
  padding: 14px 16px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 12.5px;
  color: var(--text-2);
  box-shadow: var(--shadow-1);
  animation: float 7s ease-in-out infinite;
  animation-delay: -1s;
  max-width: 280px;
}
.hero-visual .mono-snippet .k { color: var(--purple); }
.hero-visual .mono-snippet .v { color: var(--cyan); }
.hero-visual .mono-snippet .c { color: var(--text-3); }
.hero-visual .mono-snippet .p { color: var(--blue-2); }

/* =========================================
   ABOUT
   ========================================= */
.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32px;
  align-items: stretch;
}
.about-card {
  background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.01));
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  padding: 40px;
  backdrop-filter: blur(10px);
}
.about-card.large { padding: 48px; }
.about-card h2 { margin-bottom: 18px; }
.about-card p {
  color: var(--text-2);
  font-size: 16.5px;
  margin-bottom: 16px;
}
.about-card p strong { color: var(--text); }
.about-card .stats {
  margin-top: 30px;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}
.about-card .stat {
  background: rgba(255,255,255,.03);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 18px 20px;
}
.about-card .stat .num {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 30px;
  font-weight: 700;
  background: var(--grad-primary);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.about-card .stat .lab { font-size: 13px; color: var(--text-3); text-transform: uppercase; letter-spacing: .08em; }

.about-side {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.side-card {
  background: rgba(255,255,255,.025);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 22px 24px;
  display: flex;
  align-items: flex-start;
  gap: 14px;
}
.side-card .icon {
  width: 42px; height: 42px;
  border-radius: 10px;
  background: var(--grad-soft);
  display: grid; place-items: center;
  color: var(--blue-2);
  flex-shrink: 0;
}
.side-card strong { display: block; font-weight: 600; margin-bottom: 4px; }
.side-card p { color: var(--text-2); font-size: 14.5px; }

/* =========================================
   SKILLS
   ========================================= */
.skills-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
.skill-card {
  position: relative;
  background:
    linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  padding: 30px 28px;
  overflow: hidden;
  transition: transform .35s var(--ease), border-color .25s, box-shadow .25s;
}
.skill-card::before {
  content: "";
  position: absolute;
  inset: 0;
  background: var(--grad-soft);
  opacity: 0;
  transition: opacity .35s var(--ease);
  z-index: 0;
}
.skill-card:hover { transform: translateY(-6px); border-color: var(--line-2); box-shadow: var(--shadow-2); }
.skill-card:hover::before { opacity: 1; }
.skill-card > * { position: relative; z-index: 1; }
.skill-card .top {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 20px;
}
.skill-card .icon-wrap {
  width: 56px; height: 56px;
  border-radius: 14px;
  background: var(--grad-primary);
  display: grid; place-items: center;
  color: #fff;
  box-shadow: 0 10px 30px rgba(99,102,241,.35);
}
.skill-card .badge {
  font-size: 11px;
  padding: 5px 10px;
  border-radius: 100px;
  background: rgba(255,255,255,.05);
  border: 1px solid var(--line);
  color: var(--text-3);
  letter-spacing: .08em;
  text-transform: uppercase;
}
.skill-card h3 { margin-bottom: 8px; }
.skill-card p { color: var(--text-2); font-size: 14.5px; margin-bottom: 22px; min-height: 60px; }
.skill-card .progress {
  height: 6px;
  border-radius: 100px;
  background: rgba(255,255,255,.06);
  overflow: hidden;
}
.skill-card .progress > span {
  display: block;
  height: 100%;
  background: var(--grad-primary);
  border-radius: 100px;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 1.2s var(--ease);
}
.skill-card.in-view .progress > span { transform: scaleX(var(--p)); }
.skill-card .progress-label {
  display: flex; justify-content: space-between;
  margin-top: 10px;
  font-size: 12px;
  color: var(--text-3);
}

/* Coming-soon placeholder card */
.skill-card.locked .icon-wrap {
  background: rgba(255,255,255,.06);
  box-shadow: none;
  color: var(--text-3);
}
.skill-card.locked h3, .skill-card.locked p { color: var(--text-3); }
.skill-card.locked .badge { color: var(--purple); border-color: rgba(168,85,247,.3); background: rgba(168,85,247,.08); }

/* =========================================
   PROJECTS
   ========================================= */
.projects-toolbar {
  display: flex; flex-wrap: wrap; justify-content: center;
  gap: 10px;
  margin-bottom: 40px;
}
.project-filter {
  padding: 9px 18px;
  border-radius: 100px;
  background: rgba(255,255,255,.04);
  border: 1px solid var(--line);
  color: var(--text-2);
  font-size: 14px;
  font-weight: 500;
  transition: all .25s var(--ease);
}
.project-filter:hover { color: #fff; background: rgba(255,255,255,.08); }
.project-filter.active {
  background: #fff;
  color: #020617;
  border-color: #fff;
}

.projects-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.project-card {
  position: relative;
  background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  overflow: hidden;
  transition: transform .4s var(--ease), border-color .25s, box-shadow .25s;
  display: flex;
  flex-direction: column;
}
.project-card:hover {
  transform: translateY(-8px) perspective(1000px) rotateX(2deg);
  border-color: var(--line-2);
  box-shadow: var(--shadow-2);
}
.project-thumb {
  aspect-ratio: 16 / 10;
  position: relative;
  overflow: hidden;
  background: var(--bg-1);
}
.project-thumb .preview {
  position: absolute; inset: 0;
  display: grid; place-items: center;
  font-family: 'JetBrains Mono', monospace;
  transition: transform .6s var(--ease);
}
.project-card:hover .project-thumb .preview { transform: scale(1.06); }
.project-thumb .preview.t1 { background: linear-gradient(135deg, #1e3a8a, #6d28d9); }
.project-thumb .preview.t2 { background: linear-gradient(135deg, #0e7490, #1e40af); }
.project-thumb .preview.t3 { background: linear-gradient(135deg, #4c1d95, #be185d); }
.project-thumb .preview.t4 { background: linear-gradient(135deg, #064e3b, #1e3a8a); }
.project-thumb .preview.t5 { background: linear-gradient(135deg, #7c2d12, #92400e); }
.project-thumb .preview.t6 { background: linear-gradient(135deg, #831843, #1e3a8a); }
.project-thumb .preview .code-mock {
  background: rgba(2,6,23,.55);
  border: 1px solid rgba(255,255,255,.15);
  border-radius: 10px;
  padding: 14px 16px;
  font-size: 11px;
  color: #fff;
  font-family: 'JetBrains Mono', monospace;
  width: 75%;
  backdrop-filter: blur(6px);
}
.project-thumb .preview .code-mock .dot-row { display:flex; gap:6px; margin-bottom: 10px; }
.project-thumb .preview .code-mock .dot-row span { width: 8px; height: 8px; border-radius: 50%; }
.project-thumb .preview .code-mock .dot-row span:nth-child(1) { background: #ef4444; }
.project-thumb .preview .code-mock .dot-row span:nth-child(2) { background: #eab308; }
.project-thumb .preview .code-mock .dot-row span:nth-child(3) { background: #22c55e; }
.project-thumb .preview .code-mock .lines > div { height: 6px; border-radius: 3px; margin-bottom: 6px; opacity: .7; }
.project-thumb .preview .code-mock .lines > div:nth-child(1) { width: 60%; background: #3b82f6; }
.project-thumb .preview .code-mock .lines > div:nth-child(2) { width: 80%; background: #a855f7; }
.project-thumb .preview .code-mock .lines > div:nth-child(3) { width: 40%; }
